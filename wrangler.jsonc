{
  "name": "parcl-volume-tracker",
  "main": "src/index.js",
  "compatibility_date": "2026-11-06",
  "assets": {
    "directory": "./public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "parcl-tracker-db",
      "database_id": "YOUR_ACTUAL_D1_DATABASE_ID"
    }
  ]
}
